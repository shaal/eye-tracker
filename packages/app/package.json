{
  "name": "@eye-tracker/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron shell: main process engine bridge, control window, click-through overlay",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "dev.eyetracker.app",
    "// productName": "Must stay 'Eye Tracker': it is what app.setName() uses, so it decides the userData directory that scripts/recordings.mjs and scripts/diagnostics.mjs read.",
    "productName": "Eye Tracker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map"
    ],
    "// asarUnpack": "A .node cannot be dlopen'd from inside an asar archive.",
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@eye-tracker/core": "*",
    "@eye-tracker/native": "*",
    "@mediapipe/tasks-vision": "^0.10.35"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.0.0"
  }
}
